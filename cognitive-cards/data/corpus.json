  "version": "1.0",
  "entries": [
    {
      "id": "corpus_01_001",
      "card_id": "card_01",
      "type": "excerpt",
      "source": { "title": "哥德尔、埃舍尔、巴赫", "author": "Douglas Hofstadter", "type": "book", "url": "", "year": 1979 },
      "content": "一个系统无法在自身内部证明自身的完备性和一致性。任何足够强大的形式系统，其一致性命题都必须在系统外部才能证明。",
      "annotation": "关于自我指涉系统之局限的经典论述，语言简洁、意象清晰，可作为二阶观察者困境的类比引入。",
      "style_tags": ["学术", "清晰", "类比"],
      "relation_tags": ["self_reference", "incompleteness", "system_boundary"],
      "match_keywords": ["自我指涉", "不完备", "系统边界", "二阶观察者"],
      "quality_score": 4.5,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 3, "last_used_at": "2026-07-22T00:00:00Z" }
    },
    {
      "id": "corpus_01_002",
      "card_id": "card_01",
      "type": "original",
      "source": { "title": "认知卡片·设计笔记", "author": "designer", "type": "note", "url": "", "year": 2026 },
      "content": "你试图用一个工具来改变使用工具的自己。这是自我指涉的最纯粹形态——工具即是镜子，镜中的你同时是设计师和被设计者。",
      "annotation": "用简洁的比喻戳中二阶观察者困境的本质：工具即镜子。适合作为体验入口的引导语。",
      "style_tags": ["诗意", "简洁", "意象"],
      "relation_tags": ["self_reference", "mirror_metaphor"],
      "match_keywords": ["设计者", "使用者", "镜子", "自我指涉", "审视"],
      "quality_score": 4.0,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 5, "last_used_at": "2026-07-22T00:00:00Z" }
    },
    {
      "id": "corpus_02_001",
      "card_id": "card_02",
      "type": "original",
      "source": { "title": "认知卡片·设计笔记", "author": "designer", "type": "note", "url": "", "year": 2026 },
      "content": "不要和悖论辩论。悖论是一面墙，不是一扇门。绕过它，而不是试图穿过它。用身体，不用语言。",
      "annotation": "悖论绕过的核心意象：墙与门。用最短的句式传递绕过策略。",
      "style_tags": ["简洁", "犀利", "意象"],
      "relation_tags": ["paradox", "bypass", "body"],
      "match_keywords": ["悖论", "绕过", "身体", "语言", "墙", "门"],
      "quality_score": 4.2,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 4, "last_used_at": "2026-07-22T00:00:00Z" }
    },
    {
      "id": "corpus_02_002",
      "card_id": "card_02",
      "type": "reference",
      "source": { "title": "禅宗公案", "author": "传统", "type": "text", "url": "", "year": 0 },
      "content": "不立文字，教外别传。直指人心，见性成佛。",
      "annotation": "禅宗对非语义通道的极致表达。不立文字即是绕过语言困境的根本方法。",
      "style_tags": ["古典", "极简", "深刻"],
      "relation_tags": ["zen", "non_verbal", "direct_experience"],
      "match_keywords": ["不立文字", "禅宗", "非语言", "直指", "体验"],
      "quality_score": 4.8,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 6, "last_used_at": "2026-07-22T00:00:00Z" }
    },
    {
      "id": "corpus_03_001",
      "card_id": "card_03",
      "type": "original",
      "source": { "title": "认知卡片·设计笔记", "author": "designer", "type": "note", "url": "", "year": 2026 },
      "content": "最好的老师不说教，只改变教室的温度、光线和座位排列。你不知道被改变了什么——你只知道你变了。",
      "annotation": "环境级工具的终极比喻：教学空间的设计。适合引入环境级工具的概念。",
      "style_tags": ["诗意", "温和", "比喻"],
      "relation_tags": ["environment", "education", "metaphor"],
      "match_keywords": ["环境", "温度", "光线", "改变", "条件", "不说教"],
      "quality_score": 4.3,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 3, "last_used_at": "2026-07-22T00:00:00Z" }
    },
    {
      "id": "corpus_03_002",
      "card_id": "card_03",
      "type": "excerpt",
      "source": { "title": "思考，快与慢", "author": "Daniel Kahneman", "type": "book", "url": "", "year": 2011 },
      "content": "环境中的细微线索可以在不进入意识的情况下显著影响行为。启动效应揭示了我们所称的'自由意志'有多少是由情境自动激活的。",
      "annotation": "心理学经典的启动效应研究，为环境级工具的设计提供科学依据。",
      "style_tags": ["学术", "清晰", "证据"],
      "relation_tags": ["priming", "environment", "psychology"],
      "match_keywords": ["环境线索", "启动效应", "情境", "自动激活", "意识"],
      "quality_score": 4.0,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 2, "last_used_at": "2026-07-22T00:00:00Z" }
    },
    {
      "id": "corpus_05_001",
      "card_id": "card_05",
      "type": "original",
      "source": { "title": "认知卡片·设计笔记", "author": "designer", "type": "note", "url": "", "year": 2026 },
      "content": "飞轮启动前最安静的时刻，恰恰是最需要信任的时刻。你不需要推动它——你只需要把手放在上面。",
      "annotation": "适合安抚过度准备阶段的焦虑，用温和意象降低启动门槛。关键词：信任、放手。",
      "style_tags": ["诗意", "温和", "简洁"],
      "relation_tags": ["flywheel", "trust", "surrender"],
      "match_keywords": ["启动", "信任", "阻力", "安静", "准备", "焦虑"],
      "quality_score": 4.7,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 8, "last_used_at": "2026-07-22T00:00:00Z" }
    },
    {
      "id": "corpus_05_002",
      "card_id": "card_05",
      "type": "original",
      "source": { "title": "认知卡片·设计笔记", "author": "designer", "type": "note", "url": "", "year": 2026 },
      "content": "每一次预热都不是浪费，而是在告诉你的神经系统：安全了，可以开始了。",
      "annotation": "将预热重新定义为神经系统信号，而非时间浪费。降低对'准备时间'的负罪感。",
      "style_tags": ["温暖", "清晰", "安抚"],
      "relation_tags": ["warmup", "nervous_system", "safety"],
      "match_keywords": ["预热", "过渡", "开始", "安全", "神经系统", "浪费"],
      "quality_score": 4.5,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 7, "last_used_at": "2026-07-22T00:00:00Z" }
    },
    {
      "id": "corpus_07_001",
      "card_id": "card_07",
      "type": "original",
      "source": { "title": "认知卡片·设计笔记", "author": "designer", "type": "note", "url": "", "year": 2026 },
      "content": "不要告诉一个人水是湿的。把他放进水里。他出来之后，什么都知道了——不是从你这里学到的，而是从水里。",
      "annotation": "具身认知的极致比喻：直接体验优于任何解释。适合在引导词中引用。",
      "style_tags": ["诗意", "意象", "简洁"],
      "relation_tags": ["embodied", "experiential", "water_metaphor"],
      "match_keywords": ["具身", "体验", "处境", "知道", "涌现", "互动"],
      "quality_score": 4.6,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 6, "last_used_at": "2026-07-22T00:00:00Z" }
    },
    {
      "id": "corpus_07_002",
      "card_id": "card_07",
      "type": "reference",
      "source": { "title": "道德经", "author": "老子", "type": "classic", "url": "", "year": -500 },
      "content": "上善若水。水善利万物而不争，处众人之所恶，故几于道。",
      "annotation": "道家'水'的意象——不争、处下、自然流动。与具身认知的'不灌输、自发涌现'相通。",
      "style_tags": ["古典", "诗意", "深刻"],
      "relation_tags": ["water", "taoism", "non_action"],
      "match_keywords": ["水", "自然", "不争", "流动", "道", "体验"],
      "quality_score": 4.9,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 10, "last_used_at": "2026-07-22T00:00:00Z" }
    },
    {
      "id": "corpus_09_001",
      "card_id": "card_09",
      "type": "original",
      "source": { "title": "认知卡片·设计笔记", "author": "designer", "type": "note", "url": "", "year": 2026 },
      "content": "不要试图拔掉旧的杂草。种满新的花，旧的杂草自然没有空间生长。你不需要打一场仗——你只需要创造一个更好的花园。",
      "annotation": "信念覆盖机制的温柔比喻：花园而非战场。适合在引导词中引入'不对抗'的态度。",
      "style_tags": ["诗意", "温和", "意象"],
      "relation_tags": ["garden", "growth", "non_combat"],
      "match_keywords": ["信念", "覆盖", "花园", "生长", "对抗", "自然消退"],
      "quality_score": 4.4,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 5, "last_used_at": "2026-07-22T00:00:00Z" }
    },
    {
      "id": "corpus_09_002",
      "card_id": "card_09",
      "type": "excerpt",
      "source": { "title": "习惯的力量", "author": "Charles Duhigg", "type": "book", "url": "", "year": 2012 },
      "content": "你不能消除一个坏习惯——你只能改变它。保持同样的触发线索和奖赏，但插入新的惯例。旧的神经通路不会消失，但它们会被新的通路包裹。",
      "annotation": "神经科学视角：旧的回路不会被删除，而是被新的回路覆盖。这与'信念覆盖'的设计原则一致。",
      "style_tags": ["学术", "清晰", "证据"],
      "relation_tags": ["habit", "neuroscience", "override"],
      "match_keywords": ["习惯", "神经通路", "覆盖", "触发", "奖赏", "改变"],
      "quality_score": 4.1,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 3, "last_used_at": "2026-07-22T00:00:00Z" }
    },
    {
      "id": "corpus_10_001",
      "card_id": "card_10",
      "type": "original",
      "source": { "title": "认知卡片·设计笔记", "author": "designer", "type": "note", "url": "", "year": 2026 },
      "content": "不要问'为什么我还没到那里'。看看你的脚——你已经在走了。你现在踩着的这块地，就是起点。不需要往回走，也不需要跳过去。从脚下开始。",
      "annotation": "重新定向能量的核心意象：脚下即是起点。消除'需要先做好准备'的错觉。",
      "style_tags": ["温暖", "简洁", "意象"],
      "relation_tags": ["starting_point", "present", "energy"],
      "match_keywords": ["起点", "脚下", "能量", "开始", "现在", "准备"],
      "quality_score": 4.3,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 4, "last_used_at": "2026-07-22T00:00:00Z" }
    },
    {
      "id": "corpus_10_002",
      "card_id": "card_10",
      "type": "reference",
      "source": { "title": "传习录", "author": "王阳明", "type": "classic", "url": "", "year": 1518 },
      "content": "知而不行，只是未知。",
      "annotation": "王阳明心学的核心论断：真正的'知道'必然包含'做到'的能力。重新定向能量的底层哲学——不需要更多知识，只需要行动。",
      "style_tags": ["古典", "极简", "深刻"],
      "relation_tags": ["knowing_doing", "confucianism", "action"],
      "match_keywords": ["知行合一", "知道", "行动", "做到", "王阳明"],
      "quality_score": 4.7,
      "metadata": { "added_at": "2026-07-22T00:00:00Z", "added_by": "designer", "usage_count": 8, "last_used_at": "2026-07-22T00:00:00Z" }
    }
  ]
}
